# Copy to `.env.local` and fill in. See SHOWCASE_SETUP.md for a step-by-step guide.
# Every value is optional for the app to BUILD/RUN — the Showcase degrades to an
# empty state until the database + at least one OAuth provider are configured.

# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# App runtime → TRANSACTION POOLER connection (port 6543).
#   Supabase dashboard → Connect → "Transaction pooler".
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations → DIRECT connection (port 5432).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Auth.js (NextAuth) ─────────────────────────────────────────────────────
# Generate with:  npx auth secret
AUTH_SECRET=""
# Only needed if auto-detection is wrong (usually fine to leave unset on Vercel):
# AUTH_URL="http://localhost:3000"

# OAuth providers — set only the ones you want live. A provider appears in the
# sign-in UI only when BOTH its ID and SECRET are present.
# Callback URL for each provider:  <site>/api/auth/callback/<provider>
#   e.g. http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ─── Rendering & storage (self-hosted / Coolify) ────────────────────────────
# Where the render pipeline keeps its files. All three default to the OS temp
# dir, which is correct locally and WRONG in a container: the showcase library
# is not scratch, and on the default it is wiped by every redeploy.
#
# Mount one persistent volume (e.g. /data) and point all three inside it —
# same filesystem, so promoting a render to the showcase stays an atomic
# rename instead of a multi-megabyte copy.
# RENDER_WORK_DIR="/data/renders"      # exports; deleted on download, swept after 10 min
# AUDIO_WORK_DIR="/data/audio"         # uploaded soundtracks; swept after 6 h
# SHOWCASE_WORK_DIR="/data/showcase"   # approved videos; NEVER swept — this is the library

# Where the built PRO registry items are read from. Defaults to
# registry/.private/, which is what `split-pro` writes and what a dev checkout
# uses. Production MUST override it: the image is built from the PUBLIC GitHub
# repo, registry/snap-cn-pro/ is gitignored, so the build context carries no pro
# source and the default directory comes out empty — every pro install 404s.
# Put the files on the same persistent volume and point here. See DEPLOYMENT.md.
# PRO_PRIVATE_DIR="/data/private"      # scp'd in; survives redeploys, never in an image layer

# Simultaneous renders, and Chromium tabs per render. The defaults (2 and 4)
# assume 8 vCPU / 8 GB; halve both on a smaller box or renders will OOM.
# RENDER_MAX_CONCURRENT="2"
# REMOTION_CONCURRENCY="4"

# ─── Analytics (PostHog) ────────────────────────────────────────────────────
# Project API key — "Project settings → Project API key". Public by design; it
# is in the client bundle. Without it the site runs with analytics disabled
# rather than broken, so a fork needs nothing here.
NEXT_PUBLIC_POSTHOG_KEY=""
# Dashboard host, which also picks the region. US (default) or EU:
#   https://us.posthog.com  |  https://eu.posthog.com
# next.config.ts derives the ingest + asset hosts from this, so region is one
# value, not three. Ingestion is proxied through this origin at /ingest — see
# app/posthog-provider.tsx for why that matters for a developer audience.
NEXT_PUBLIC_POSTHOG_HOST="https://us.posthog.com"
# Server-only, for the "Installed by N developers" line on component pages and
# /pro (lib/server/install-counts.ts). A *personal* API key with Query read —
# "Account settings → Personal API keys" — and the project's numeric id. Unset,
# the pages show no install count rather than a zero.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""

# Only needed to run a *production* build locally (`pnpm build && pnpm start`).
# Auth.js refuses an untrusted Host header outside dev; on Vercel it detects the
# platform and trusts it automatically, so this stays unset in deployment.
AUTH_TRUST_HOST=true

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# See EMAIL_SETUP.md for the DNS records these depend on. Every value below is
# optional: unset, no mail is sent and nothing else changes.
RESEND_API_KEY=

# The TRANSACTIONAL sender — sign-in links, the account welcome, admin alerts.
# Must be on a domain verified with Resend or every send is rejected with a 403.
EMAIL_FROM="snapcn <hello@snapcn.dev>"

# The BULK sender — the newsletter, and nothing else. A separate subdomain with
# its own DKIM key, so a campaign that earns spam complaints costs the list its
# reputation and NOT the sign-in link's. Defaults to EMAIL_FROM, which is the
# old single-stream behaviour.
EMAIL_FROM_NEWSLETTER="snapcn <news@mail.snapcn.dev>"

# Printed in the newsletter's footer. CAN-SPAM §5 requires a physical postal
# address on commercial email, and most other jurisdictions agree. Unset it
# renders nothing — which is a compliance problem, not a crash.
EMAIL_POSTAL_ADDRESS=""

# Standard Webhooks (Svix) signing secret, `whsec_…`, from the Resend webhook
# you point at <site>/api/webhooks/resend. Without it the endpoint answers 503
# and bounces and spam complaints are never recorded — which means dead
# addresses stay on the list and keep being mailed. A forged event here
# suppresses somebody's address, so it is never accepted unsigned.
RESEND_WEBHOOK_SECRET=""

# LOCAL DEVELOPMENT ONLY. Where the confirm and unsubscribe links in an email
# point. Unset they point at https://snapcn.dev, so testing double opt-in
# locally would confirm a row in production.
# EMAIL_SITE_URL="http://localhost:3000"

# ─── Billing (Dodo Payments) ────────────────────────────────────────────────
# All of them are optional. Unset, `/api/checkout` answers 503 and nobody can buy
# anything — every user is on the free plan and the rest of the site is
# unchanged, which is exactly what a fork or a self-host should get.
#
# Test and live are two separate hosts, two separate dashboards, and two
# separate sets of ids: `https://test.dodopayments.com` and
# `https://live.dodopayments.com`. (There is no `api.dodopayments.com`.) A key
# from one mode against the other's host 404s, so DODO_MODE is what picks the
# host — it defaults to `test`, so going live is a deliberate edit here rather
# than something that happens by forgetting a variable.
DODO_API_KEY=""
DODO_MODE="test"

# Standard Webhooks (Svix) signing secret, `whsec_…`, from the webhook endpoint
# you point at <site>/api/webhooks/dodo. This is the only thing standing between
# a stranger's POST and a free Pro plan: unset, the webhook answers 503 and
# activations pile up in Dodo's retry queue rather than being accepted unsigned.
DODO_WEBHOOK_SECRET=""

# Product ids for the mode above — `pdt_…`. `node scripts/dodo-products.mts
# test|live` creates or updates them from the price table in lib/plans.ts and
# prints these lines. Annual, lifetime and commercial all grant plan "pro"; the
# pack is the one-time template bundle and grants nothing.
DODO_PRODUCT_EVERYTHING_ANNUAL=""
DODO_PRODUCT_LIFETIME=""
DODO_PRODUCT_COMMERCIAL=""
DODO_PRODUCT_PACK=""

# Public origin of the bucket holding the pro components' demo videos, with no
# trailing slash — e.g. https://pro-demos.snapcn.dev. The free demos ship in
# `public/demos`; the pro ones cannot, because `registry/snap-cn-pro` is
# gitignored and a build has no way to render what it does not have. Rendered by
# `scripts/pro-demos.mts`, pushed by `scripts/pro-upload.mts`.
#
# Unset, the gallery lists no paid components at all — fourteen grey boxes is
# worse than not advertising them. The videos are the advertisement, exactly
# like the titles and descriptions the built registry already publishes; no pro
# source goes near the bucket.
NEXT_PUBLIC_PRO_DEMO_BASE=
