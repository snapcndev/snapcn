# Copy to `.env.local` and fill in. See SHOWCASE_SETUP.md for a step-by-step guide.
# Every value is optional for the app to BUILD/RUN — the Showcase degrades to an
# empty state until the database + at least one OAuth provider are configured.

# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# App runtime → TRANSACTION POOLER connection (port 6543).
#   Supabase dashboard → Connect → "Transaction pooler".
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations → DIRECT connection (port 5432).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Auth.js (NextAuth) ─────────────────────────────────────────────────────
# Generate with:  npx auth secret
AUTH_SECRET=""
# Only needed if auto-detection is wrong (usually fine to leave unset on Vercel):
# AUTH_URL="http://localhost:3000"

# OAuth providers — set only the ones you want live. A provider appears in the
# sign-in UI only when BOTH its ID and SECRET are present.
# Callback URL for each provider:  <site>/api/auth/callback/<provider>
#   e.g. http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ─── Showcase moderation ────────────────────────────────────────────────────
# Comma-separated emails allowed to open /docs/showcase/admin and approve/reject.
ADMIN_EMAILS="hello@snapcn.dev"

# ─── Rendering & storage (self-hosted / Coolify) ────────────────────────────
# Where the render pipeline keeps its files. All three default to the OS temp
# dir, which is correct locally and WRONG in a container: the showcase library
# is not scratch, and on the default it is wiped by every redeploy.
#
# Mount one persistent volume (e.g. /data) and point all three inside it —
# same filesystem, so promoting a render to the showcase stays an atomic
# rename instead of a multi-megabyte copy.
# RENDER_WORK_DIR="/data/renders"      # exports; deleted on download, swept after 10 min
# AUDIO_WORK_DIR="/data/audio"         # uploaded soundtracks; swept after 6 h
# SHOWCASE_WORK_DIR="/data/showcase"   # approved videos; NEVER swept — this is the library

# Simultaneous renders, and Chromium tabs per render. The defaults (2 and 4)
# assume 8 vCPU / 8 GB; halve both on a smaller box or renders will OOM.
# RENDER_MAX_CONCURRENT="2"
# REMOTION_CONCURRENCY="4"

# ─── Analytics (PostHog) ────────────────────────────────────────────────────
# Project API key — "Project settings → Project API key". Public by design; it
# is in the client bundle. Without it the site runs with analytics disabled
# rather than broken, so a fork needs nothing here.
NEXT_PUBLIC_POSTHOG_KEY=""
# Dashboard host, which also picks the region. US (default) or EU:
#   https://us.posthog.com  |  https://eu.posthog.com
# next.config.ts derives the ingest + asset hosts from this, so region is one
# value, not three. Ingestion is proxied through this origin at /ingest — see
# app/posthog-provider.tsx for why that matters for a developer audience.
NEXT_PUBLIC_POSTHOG_HOST="https://us.posthog.com"

# Transactional email (welcome mail on newsletter signup and first sign-in).
# Unset = no mail is sent, and nothing else changes. EMAIL_FROM must be on a
# domain verified with Resend or every send is rejected with a 403.
# Only needed to run a *production* build locally (`pnpm build && pnpm start`).
# Auth.js refuses an untrusted Host header outside dev; on Vercel it detects the
# platform and trusts it automatically, so this stays unset in deployment.
AUTH_TRUST_HOST=true

RESEND_API_KEY=
EMAIL_FROM="snapcn <hello@snapcn.dev>"

# ─── Billing (Dodo Payments) ────────────────────────────────────────────────
# All five are optional. Unset, `/api/checkout` answers 503 and nobody can buy
# anything — every user is on the free plan and the rest of the site is
# unchanged, which is exactly what a fork or a self-host should get.
#
# Test and live are two separate hosts, two separate dashboards, and two
# separate sets of ids: `https://test.dodopayments.com` and
# `https://live.dodopayments.com`. (There is no `api.dodopayments.com`.) A key
# from one mode against the other's host 404s, so DODO_MODE is what picks the
# host — it defaults to `test`, so going live is a deliberate edit here rather
# than something that happens by forgetting a variable.
DODO_API_KEY=""
DODO_MODE="test"

# Standard Webhooks (Svix) signing secret, `whsec_…`, from the webhook endpoint
# you point at <site>/api/webhooks/dodo. This is the only thing standing between
# a stranger's POST and a free Pro plan: unset, the webhook answers 503 and
# activations pile up in Dodo's retry queue rather than being accepted unsigned.
DODO_WEBHOOK_SECRET=""

# Product ids for the mode above — `pdt_…`. Starter is the monthly
# subscription, the annual one is a SEPARATE product (Dodo snapshots the billing
# interval onto the subscription, so cadence cannot be a flag on one product),
# and the pack is the one-time template bundle.
DODO_PRODUCT_STARTER=""
DODO_PRODUCT_STARTER_ANNUAL=""
DODO_PRODUCT_PACK=""
